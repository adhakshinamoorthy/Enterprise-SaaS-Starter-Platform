{
  "AllowedHosts": "*",
  "Cors": { "Origins": [ "https://localhost:5173" ] },
  "ReverseProxy": {
    "Routes": {
      "catalog": { "ClusterId": "catalog", "Match": { "Path": "/catalog/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/catalog" } ] },
      "tenant": { "ClusterId": "tenant", "Match": { "Path": "/tenant/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/tenant" } ] }
    },
    "Clusters": {
      "catalog": { "Destinations": { "primary": { "Address": "http://catalog-api:8080" } } },
      "tenant": { "Destinations": { "primary": { "Address": "http://tenant-api:8080" } } }
    }
  },
  "Serilog": { "MinimumLevel": "Information", "Enrich": [ "FromLogContext" ] }
}
